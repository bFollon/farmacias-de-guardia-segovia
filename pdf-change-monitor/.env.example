# Bearer token for POST /check on this monitor's own HTTP API.
# Generate a strong random value, e.g.: openssl rand -hex 32
MONITOR_API_KEY=replace_with_a_strong_secret

# The data service's admin key (server/.env's RELOAD_KEY) — must match exactly. Used to
# call POST /api/refresh/:locationId when a PDF change is detected. Never the client-facing
# API_KEY.
DATA_SERVICE_RELOAD_KEY=replace_with_the_data_services_RELOAD_KEY

# Base URL of the data service (server/). Same host, so localhost + its port is normal.
DATA_SERVICE_URL=http://localhost:3765

# iCloud SMTP credentials
# Sender address (your Apple ID email)
SMTP_USER=follon.bruno@icloud.com
# App-specific password — generate at: appleid.apple.com → Sign-In & Security → App-Specific Passwords
SMTP_PASS=replace_with_app_specific_password

# Email address to receive change notifications
NOTIFY_EMAIL=bfollon.dev@icloud.com

# Port to listen on (default: 3702 — 3700/3701 are used by InterSego's server/monitor on
# the same Pi, 3765 is farmacias-data-service)
PORT=3702

# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0
